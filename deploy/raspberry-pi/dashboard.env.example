SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DASHBOARD_OWNER_EMAIL=owner@example.com
DASHBOARD_PASSWORD_HASH=generated-with-npm-run-auth-hash
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_SECURE_COOKIE=false
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=your-production-token-used-read-only-by-owner-setup
# Keep false until add_owner_setup_controls.sql is installed and verified.
DASHBOARD_ALLOW_WRITES=false
